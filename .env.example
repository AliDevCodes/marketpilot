# Copy this file to .env and adjust values for your local machine.
# Never commit the real .env file.

# Local PostgreSQL connection (no Docker required).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://marketpilot:change-me@localhost:5432/marketpilot

# Application environment: development | test | production
APP_ENV=development

# Base currency for portfolio reporting (unit convention documented in docs/DATA_CONVENTIONS.md once written)
BASE_CURRENCY=IRT
